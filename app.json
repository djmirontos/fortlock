{
  "expo": {
    "name": "FortLock",
    "slug": "fortlock",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "fortlock",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4F6FFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.daryljm.fortlock"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F6FFF"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.daryljm.fortlock"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "FortLock uses Face ID to unlock your vault."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FortLock uses the camera to scan 2FA QR codes and send passwords to desktop."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "FortLock uses Face ID to unlock your vault."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "08f94d62-2c57-41f6-a7f8-d6da177ddd3b"
      }
    }
  }
}
